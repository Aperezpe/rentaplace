{
  "name": "rentaplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local vacation rental marketplace for guests and hosts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "seed": "node --disable-warning=ExperimentalWarning data/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-isolation=none test/*.test.ts",
    "bench": "node --disable-warning=ExperimentalWarning test/bench.ts",
    "journey": "node --disable-warning=ExperimentalWarning test/journey.ts",
    "rap": "node --disable-warning=ExperimentalWarning bin/rap.ts"
  }
}
